# ╔══════════════════════════════════════════════╗
# ║  ОЦІНКА24 Bot v2.0 — Налаштування (.env)    ║
# ╚══════════════════════════════════════════════╝
# Скопіюйте: copy .env.example .env
# НІКОЛИ не публікуйте .env у Git!

# ── Токен бота (від @BotFather) ──────────────────
BOT_TOKEN=1234567890:ABCDEFabcdef1234567890abcdefABCDEF

# ── Telegram ID адміністраторів ──────────────────
# Один або кілька через кому: 123456789,987654321
# Дізнатися: написати @userinfobot
ADMIN_IDS=123456789

# ── ID закритого каналу для документів ──────────
# Формат: -1001234567890 (з мінусом!)
# Як отримати: додайте @userinfobot у канал, він поверне ID
# Якщо каналу немає — залиште 0 або видаліть рядок
CHANNEL_ID=0

# ── Web App URL (GitHub Pages) ───────────────────
# Після завантаження webapp/index.html на GitHub Pages:
# https://ВАШ_USERNAME.github.io/otsinka24-bot/
# Якщо не налаштовано — кнопка Web App не показується
WEBAPP_URL=
