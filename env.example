#
# 1. Скопіюйте цей файл: cp .env.example .env
# 2. Заповніть значення нижче
# 3. НІКОЛИ не публікуйте .env у Git!

# ── Токен бота (від @BotFather) ──────────────────
BOT_TOKEN=1234567890:ABCDEFabcdef1234567890abcdefABCDEF

# ── Telegram ID адміністраторів ──────────────────
# Один або кілька ID через кому (без пробілів)
# Дізнатися свій ID: написати @userinfobot
ADMIN_IDS=123456789,987654321
